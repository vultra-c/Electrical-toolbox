<template>
  <div class="page {{pageAnim}}">

    <list class="scroll">
      <list-item type="tip">
        <div class="panel">
          <!-- 接法 -->
          <div class="seg" style="margin-bottom: 10px;">
            <div class="seg-item {{mode === 'limit' ? 'seg-item--on' : ''}}" @click="setMode('limit')">
              <text class="seg-text {{mode === 'limit' ? 'seg-text--on' : ''}}">限流接法</text>
            </div>
            <div class="seg-item {{mode === 'divider' ? 'seg-item--on' : ''}}" @click="setMode('divider')">
              <text class="seg-text {{mode === 'divider' ? 'seg-text--on' : ''}}">分压接法</text>
            </div>
          </div>

          <div class="field" @click="openPad('U')">
            <text class="field-label">电源电压 U</text>
            <text class="field-value">{{disp('U')}}</text>
            <text class="field-unit">V</text>
          </div>
          <div class="field" @click="openPad('R0')">
            <text class="field-label">定值电阻 R0</text>
            <text class="field-value">{{disp('R0')}}</text>
            <text class="field-unit">Ω</text>
          </div>
          <div class="field" @click="openPad('Rmax')">
            <text class="field-label">变阻器最大 Rmax</text>
            <text class="field-value">{{disp('Rmax')}}</text>
            <text class="field-unit">Ω</text>
          </div>
          <div class="field" @click="openPad('Rload')">
            <text class="field-label">负载电阻 RL</text>
            <text class="field-value">{{disp('Rload')}}</text>
            <text class="field-unit">Ω</text>
          </div>

          <div class="btn" @click="run" style="margin-top: 4px;">
            <text class="btn-text">求示数变化范围</text>
          </div>

          <!-- 范围 -->
          <div class="card card--flat" if="{{out.ok}}" style="margin-top: 10px;">
            <text class="card-title">示数范围</text>
            <div class="kv">
              <text class="kv-k">电流表示数 I</text>
              <text class="kv-v kv-v--hi">{{out.Irange}}</text>
            </div>
            <div class="kv">
              <text class="kv-k">电压表示数 U</text>
              <text class="kv-v kv-v--hi">{{out.Urange}}</text>
            </div>
            <div class="kv">
              <text class="kv-k">变阻器最大功率</text>
              <text class="kv-v kv-v--warn">{{out.Pmax}}</text>
            </div>
          </div>

          <!-- 变化趋势 -->
          <div class="card" if="{{out.ok}}" style="margin-top: 8px;">
            <text class="card-title">滑片移动时的变化</text>
            <text class="step">接入电阻变大：I {{out.iUp}}，U定 {{out.uUp}}，P {{out.pUp}}</text>
            <text class="step">接入电阻变小：I {{out.iDn}}，U定 {{out.uDn}}，P {{out.pDn}}</text>
            <text class="step">判断口诀：先串并 → 再局部 → 最后干路</text>
          </div>

          <!-- 开关控制 -->
          <div class="card" style="margin-top: 8px;">
            <text class="card-title">开关并联支路通断对比</text>
            <div class="kv"><text class="kv-k">仅 R0 支路</text><text class="kv-v">{{out.solo}}</text></div>
            <div class="kv"><text class="kv-k">两支路全接</text><text class="kv-v kv-v--hi">{{out.dual}}</text></div>
            <text class="step">并联支路越多，总电阻越接近最小的那条支路</text>
          </div>
        </div>
      </list-item>
    </list>

    <div class="topbar">
      <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 84px;" />
      <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
      <text style="position: absolute; left: 78px; top: 20px; width: 180px; line-height: 40px; font-size: 28px; font-weight: bold; color: #FFFFFF; text-align: center; lines: 1;">动态电路</text>
      <text style="position: absolute; left: 78px; top: 56px; width: 180px; line-height: 22px; font-size: 18px; font-weight: bold; color: #5B6B84; text-align: center; lines: 1;">滑变与开关引起的示数变化</text>
    </div>

    <div if="{{padOpen}}" class="mask"></div>
    <div if="{{padOpen}}" class="keypad">
      <div class="keypad-head">
        <text class="keypad-title">{{padTitle}}</text>
        <text class="keypad-value">{{buffer}}</text>
      </div>
      <div class="keypad-body">
        <div class="key-row">
          <div class="key" for="{{row1}}" tid="k" @click="key($item)"><text class="key-text">{{$item}}</text></div>
        </div>
        <div class="key-row">
          <div class="key" for="{{row2}}" tid="k" @click="key($item)"><text class="key-text">{{$item}}</text></div>
        </div>
        <div class="key-row">
          <div class="key" for="{{row3}}" tid="k" @click="key($item)"><text class="key-text">{{$item}}</text></div>
        </div>
        <div class="key-row">
          <div class="key key--fn" @click="key('.')"><text class="key-text">.</text></div>
          <div class="key" @click="key('0')"><text class="key-text">0</text></div>
          <div class="key key--del" @click="key('<')"><text class="key-text">⌫</text></div>
        </div>
        <div class="key-row key-row--last">
          <div class="key key--fn" @click="key('C')"><text class="key-text key-text--fn">清空</text></div>
          <div class="key key--ok key--wide" @click="confirmPad"><text class="key-text key-text--ok">确定</text></div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import numpad from '../../common/numpad.js'
import * as phy from '../../common/physics.js'

var LABELS = {
  U: '电源电压 U (V)',
  R0: '定值电阻 R0 (Ω)',
  Rmax: '变阻器最大阻值 (Ω)',
  Rload: '负载电阻 RL (Ω)'
}

export default {
  private: {
    pageAnim: 'page--anim',
    mode: 'limit',
    vals: { U: '6', R0: '10', Rmax: '20', Rload: '10' },
    padOpen: false,
    padKey: '',
    padTitle: '',
    buffer: '0',
    padStarted: false,
    row1: ['1', '2', '3'],
    row2: ['4', '5', '6'],
    row3: ['7', '8', '9'],
    out: { ok: false }
  },

  onInit() {
    this.run()
  },

  onShow() {
    var self = this
    this.pageAnim = 'page--back'
    setTimeout(function () {
      if (self.$valid) self.pageAnim = ''
    }, 300)
  },

  num(k) {
    var v = parseFloat(this.vals[k])
    return isNaN(v) ? 0 : v
  },

  disp(k) {
    var v = this.vals[k]
    if (v === '' || v === undefined) return '未填'
    var n = parseFloat(v)
    if (isNaN(n)) return '未填'
    return String(parseFloat(n.toPrecision(5)))
  },

  setMode(m) {
    this.mode = m
    this.run()
  },

  openPad(key) {
    this.padKey = key
    this.padTitle = LABELS[key]
    this.padOpen = true
    this.padStarted = false
    this.buffer = this.vals[key] || '0'
  },

  key(k) {
    this.buffer = numpad.press({ buffer: this.buffer, started: this.padStarted }, k)
    this.padStarted = true
  },

  confirmPad() {
    var v = numpad.confirm({ buffer: this.buffer })
    this.vals[this.padKey] = String(v)
    this.padOpen = false
    this.buffer = '0'
    this.padStarted = false
    this.run()
  },

  run() {
    var U = this.num('U')
    var R0 = this.num('R0')
    var Rmax = this.num('Rmax')
    var RL = this.num('Rload')

    var r = phy.rheostatCalc({ R0: R0, Rmax: Rmax, Rload: RL, U: U, mode: this.mode })

    var Imin = r.Imin
    var Imax = r.Imax
    var Umin = r.Umin
    var Umax = r.Umax

    // 开关控制对比：仅 R0 支路 vs R0||R1
    var solo = RL > 0 ? U / RL : 0
    var par = (R0 * RL) / (R0 + RL)
    var dual = U / par

    this.out = {
      ok: true,
      Irange: fmtI(Imin) + ' ~ ' + fmtI(Imax),
      Urange: fmtU(Umin) + ' ~ ' + fmtU(Umax),
      Pmax: fmtP(r.Pmax || 0),
      iUp: '减小', uUp: '减小', pUp: '减小',
      iDn: '增大', uDn: '增大', pDn: '增大',
      solo: fmtI(solo) + '  （R = ' + fmtR(RL) + '）',
      dual: fmtI(dual) + '  （R = ' + fmtR(par) + '）'
    }
  },

  goBack() {
    router.back()
  }
}

function sig(n) { return String(parseFloat(n.toPrecision(4))) }
function fmtI(x) {
  var a = Math.abs(x)
  if (a < 1e-9) return '0'
  if (a >= 1) return sig(x) + 'A'
  if (a >= 1e-3) return sig(x * 1000) + 'mA'
  return sig(x * 1e6) + 'μA'
}
function fmtU(x) {
  var a = Math.abs(x)
  if (a < 1e-9) return '0'
  if (a >= 1) return sig(x) + 'V'
  if (a >= 1e-3) return sig(x * 1000) + 'mV'
  return sig(x * 1e6) + 'μV'
}
function fmtR(x) {
  if (!isFinite(x)) return '∞'
  var a = Math.abs(x)
  if (a >= 1e6) return sig(x / 1e6) + 'MΩ'
  if (a >= 1e3) return sig(x / 1e3) + 'kΩ'
  return sig(x) + 'Ω'
}
function fmtP(x) {
  var a = Math.abs(x)
  if (a < 1e-9) return '0'
  if (a >= 1) return sig(x) + 'W'
  if (a >= 1e-3) return sig(x * 1000) + 'mW'
  return sig(x * 1e6) + 'μW'
}
</script>

<style>
@import '../../common/style.css';

.panel {
  width: 100%;
  flex-direction: column;
}
</style>
