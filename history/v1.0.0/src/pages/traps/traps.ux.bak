<template>
  <div class="page {{pageAnim}}">

    <list class="scroll">
      <list-item class="trap" for="{{list}}" tid="i" type="tip">
        <div class="trap-head">
          <div class="trap-no"><text class="trap-no-text">{{pad($item.i)}}</text></div>
          <text class="trap-title">{{$item.t}}</text>
        </div>
        <text class="trap-desc">{{$item.d}}</text>
      </list-item>
      <list-item type="footer" style="height: 70px;"></list-item>
    </list>

    <div class="topbar">
      <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 84px;" />
      <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
      <text style="position: absolute; left: 78px; top: 20px; width: 180px; line-height: 40px; font-size: 28px; font-weight: bold; color: #FFFFFF; text-align: center; lines: 1;">易错点</text>
      <text style="position: absolute; left: 78px; top: 56px; width: 180px; line-height: 22px; font-size: 18px; font-weight: bold; color: #5B6B84; text-align: center; lines: 1;">中考电学高频陷阱 · 考前必看</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { TRAPS } from '../../common/knowledge.js'

export default {
  private: {
    pageAnim: 'page--anim',
    list: TRAPS
  },

  onShow() {
    var self = this
    this.pageAnim = 'page--back'
    setTimeout(function () {
      if (self.$valid) self.pageAnim = ''
    }, 300)
  },

  pad(n) {
    return n < 9 ? '0' + (n + 1) : String(n + 1)
  },

  goBack() {
    router.back()
  }
}
</script>

